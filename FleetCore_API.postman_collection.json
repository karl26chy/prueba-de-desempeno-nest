{
  "info": {
    "name": "FleetCore API - Prueba de Desempeño NestJS",
    "description": "Colección completa de endpoints para pruebas de la API FleetCore",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@fleetcore.com\",\n  \"password\": \"Password123*\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Técnico (Carlos)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos.tecnico@fleetcore.com\",\n  \"password\": \"Password123*\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Perfil Usuario",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] }
          }
        }
      ]
    },
    {
      "name": "2. Vehículos",
      "item": [
        {
          "name": "Listar Vehículos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/vehicles", "host": ["{{baseUrl}}"], "path": ["vehicles"] }
          }
        },
        {
          "name": "Consultar por Placa o ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/vehicles/ABC123", "host": ["{{baseUrl}}"], "path": ["vehicles", "ABC123"] }
          }
        },
        {
          "name": "Registrar Vehículo (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plate\": \"NEW999\",\n  \"brand\": \"Volvo\",\n  \"model\": \"FH16\",\n  \"year\": 2024,\n  \"mileage\": 15000\n}"
            },
            "url": { "raw": "{{baseUrl}}/vehicles", "host": ["{{baseUrl}}"], "path": ["vehicles"] }
          }
        }
      ]
    },
    {
      "name": "3. Mantenimientos",
      "item": [
        {
          "name": "Listar Activos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/maintenances/active", "host": ["{{baseUrl}}"], "path": ["maintenances", "active"] }
          }
        },
        {
          "name": "Mis Asignados (Técnico)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{techToken}}" }],
            "url": { "raw": "{{baseUrl}}/maintenances/my-assigned", "host": ["{{baseUrl}}"], "path": ["maintenances", "my-assigned"] }
          }
        },
        {
          "name": "Actualizar a COMPLETED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\",\n  \"workDone\": \"Reparación completada y prueba de ruta satisfactoria\",\n  \"finalCost\": 520000,\n  \"finishedAt\": \"2026-10-27T18:00:00.000Z\",\n  \"finalMileage\": 68150\n}"
            },
            "url": { "raw": "{{baseUrl}}/maintenances/2/status", "host": ["{{baseUrl}}"], "path": ["maintenances", "2", "status"] }
          }
        }
      ]
    },
    {
      "name": "4. Integración Externa (API Key)",
      "item": [
        {
          "name": "Historial Vehículo vía x-api-key",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "demo-key-partner-1" }],
            "url": { "raw": "{{baseUrl}}/external/vehicles/ABC123/history", "host": ["{{baseUrl}}"], "path": ["external", "vehicles", "ABC123", "history"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "techToken", "value": "" }
  ]
}
